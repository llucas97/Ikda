# 복사: cp .env.example .env   (Windows: copy .env.example .env)
# 실제 키는 넣지 않은 빈 예시이다. .env 는 깃에 올리지 않는다.

# --- 분석 ---
AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# CORS_ORIGINS=*
# DEBUG_USAGE=

# --- DB ---
# 비우면 SQLite 파일(./ilgeodeurim.db). 로컬 Postgres 는 docker compose up -d 후:
# DATABASE_URL=postgresql://ilgeo:ilgeo@localhost:5432/ilgeodeurim
DATABASE_URL=
# DB_AUTO_CREATE=
# DB_NULL_POOL=

# --- JWT (운영 필수, 32바이트 이상) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_ISSUER=ilgeodeurim
# JWT_AUDIENCE=ilgeodeurim-app
# ACCESS_TOKEN_TTL_MIN=15
# REFRESH_TOKEN_TTL_DAYS=60
# SESSION_MAX_DAYS=365
# REFRESH_REUSE_GRACE_S=30
# MAX_SESSIONS_PER_USER=5

# --- 주소 ---
# PUBLIC_BASE_URL=https://api.example.com
# APP_REDIRECT_URIS=ilgeodeurim://oauth/callback
# OAUTH_STATE_TTL_S=600
# LOGIN_CODE_TTL_S=120

# --- 카카오 (앱에 넣지 말 것: REST 키, 시크릿, 어드민 키) ---
KAKAO_APP_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
# KAKAO_REDIRECT_URI=
# KAKAO_USE_PKCE=1
# KAKAO_SCOPE=

# --- 구글 (웹 클라이언트 비밀번호는 서버만) ---
# 웹·Android·iOS 클라이언트 ID 를 쉼표로
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- 운영에서는 반드시 끄기 ---
# AUTH_FAKE_PROVIDER=0
# 프록시(Cloud Run 등) 뒤에서만
# TRUST_PROXY_HEADERS=0
# 1 이면 POST /api/analyze 에 로그인 필요. 기본은 끔.
# AUTH_REQUIRED_FOR_ANALYZE=0

# --- 사진 품질 검사 (AI 를 부르기 전에, 서버는 '정말 못 읽는 사진'만 막는다) ---
# QUALITY_CHECK=1
# QUALITY_BLUR_MIN=30
# QUALITY_DARK_MEAN=40
# QUALITY_BRIGHT_CLIPPED=0.95
# QUALITY_BLANK_CONTENT=0.02
# QUALITY_MIN_SHORT_SIDE=400
# QUALITY_MIN_LONG_SIDE=600

# --- 가족 연결 ---
# FAMILY_INVITE_TTL_MIN=30
# FAMILY_MAX_CHILDREN=10
# FAMILY_MAX_SENIORS=4
# FAMILY_FAIL_WINDOW_MIN=15
# FAMILY_FAIL_LIMIT=10
# FAMILY_FAIL_LIMIT_IP=30
# FAMILY_SEND_DAILY_LIMIT=30

# --- 푸시 (FCM HTTP v1). 키는 파일로 두고 경로만 적는다. 깃에 올리지 않는다 ---
# fcm | fake | none. 비우면 서비스 계정이 있으면 fcm, 없으면 none(보내지 않고 기록만)
# PUSH_PROVIDER=
# FCM_SERVICE_ACCOUNT_FILE=C:\secrets\ilgeodeurim-firebase-adminsdk.json
# 파일 대신 (Cloud Run 시크릿 등): JSON 원문 또는 base64
# FCM_SERVICE_ACCOUNT_JSON=
# 비우면 서비스 계정의 project_id
# FCM_PROJECT_ID=
# PUSH_TIMEOUT_S=5
