# 읽다 서버 환경변수 예시
# 사용법: cp .env.example .env (Windows: copy .env.example .env)
# 실제 키는 .env 에만 넣고, .env 는 git에 올리지 않습니다.

# ==============================================================================
# AI 분석
# ==============================================================================

# AI 제공자: fake / gemini / anthropic
# 비우면 키가 있는 쪽을 자동으로 선택 (없으면 fake)
AI_PROVIDER=

# Google AI Studio API 키 (https://aistudio.google.com/app/apikey)
# Gemini는 빠르고 저렴합니다 (유료 등급 권장)
GEMINI_API_KEY=

# Gemini 모델 설정 (2026-11 기준 모델명, 바뀌면 환경변수로만 변경)
# GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite   # 서류 종류 분류용 (가장 저렴)
# GEMINI_DEFAULT_MODEL=gemini-3.6-flash         # 일반 서류
# GEMINI_STRONG_MODEL=gemini-3.1-pro-preview    # 약봉투·계약서 (유료 등급 필요)
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite  # 오류 시 대체 모델
# GEMINI_THINKING_LEVEL=low                     # Gemini 3 생각 수준 (minimal/low/medium/high)
# GEMINI_TIMEOUT_S=45                           # 모델 호출 제한 시간 (초)

# Anthropic (Claude) API 키 (정확도 우선 시)
ANTHROPIC_API_KEY=

# Claude 모델 설정
# ANTHROPIC_CLASSIFY_MODEL=claude-haiku-5-5
# ANTHROPIC_DEFAULT_MODEL=claude-haiku-5-5
# ANTHROPIC_STRONG_MODEL=claude-sonnet-5-5
# ANTHROPIC_FALLBACK_MODELS=                    # Claude 대체 모델 (쉼표 구분)

# 좋은 모델로 올릴 서류 종류 (쉼표 구분)
# ESCALATE_TYPES=medicine,contract

# 업로드 제한
# MAX_IMAGES=5                                  # 최대 사진 개수
# MAX_IMAGE_MB=10                               # 사진 하나당 최대 크기 (MB)

# CORS 허용 출처 (배포 시 실제 주소로 좁히기)
# CORS_ORIGINS=*

# 디버그: 1이면 응답에 분류 결과, 걸린 시간, 토큰 수 포함 (운영에서 끄기)
# DEBUG_USAGE=

# ==============================================================================
# 데이터베이스
# ==============================================================================

# PostgreSQL: postgresql://user:password@host:5432/dbname
# 비우면 SQLite 파일 (./ilgeodeurim.db)
DATABASE_URL=

# 1이면 Postgres에서도 모델로 표 자동 생성 (평소엔 python db/migrate.py 사용)
# DB_AUTO_CREATE=

# 1이면 연결 풀 없음 (테스트용)
# DB_NULL_POOL=

# ==============================================================================
# 인증 (JWT)
# ==============================================================================

# JWT 서명 키 (운영 필수, 32바이트 이상)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# JWT 발급자 및 대상
# JWT_ISSUER=ilgeodeurim
# JWT_AUDIENCE=ilgeodeurim-app

# Access 토큰 유효 시간 (분)
# ACCESS_TOKEN_TTL_MIN=15

# Refresh 토큰 유효 시간 (일, 쓸 때마다 연장)
# REFRESH_TOKEN_TTL_DAYS=60

# 세션 최대 유지 기간 (일, 넘으면 다시 로그인)
# SESSION_MAX_DAYS=365

# Refresh 토큰 재사용 유예 시간 (초, 동시 갱신 허용)
# REFRESH_REUSE_GRACE_S=30

# 사용자당 최대 세션 수 (0이면 제한 없음)
# MAX_SESSIONS_PER_USER=5

# ==============================================================================
# 서버 주소 및 리디렉션
# ==============================================================================

# 서버 공개 주소 (OAuth 콜백 주소 생성에 사용, 운영은 https)
# PUBLIC_BASE_URL=http://localhost:8000

# 앱 리디렉션 URI (쉼표로 여러 개 가능)
# APP_REDIRECT_URIS=ilgeodeurim://oauth/callback

# OAuth state 유효 시간 (초)
# OAUTH_STATE_TTL_S=600

# 로그인 코드 유효 시간 (초)
# LOGIN_CODE_TTL_S=120

# ==============================================================================
# 카카오 로그인
# ==============================================================================
# 카카오 디벨로퍼스 콘솔에서 발급
# 주의: REST API 키, Client Secret, 어드민 키는 앱에 넣지 말 것

# 카카오 앱 ID (숫자, 필수 — 다른 앱 토큰 거부용)
KAKAO_APP_ID=

# REST API 키 (서버 인가 코드 흐름용)
KAKAO_REST_API_KEY=

# Client Secret (콘솔에서 활성화한 경우에만)
KAKAO_CLIENT_SECRET=

# 어드민 키 (탈퇴 시 연결 끊기용, 절대 앱에 노출 금지)
KAKAO_ADMIN_KEY=

# 카카오 리디렉션 URI (보통 자동 생성됨)
# KAKAO_REDIRECT_URI=

# 카카오 PKCE 사용 (1=사용, 0=사용안함)
# KAKAO_USE_PKCE=1

# 카카오 요청 스코프 (비우면 콘솔 기본 동의항목 사용)
# KAKAO_SCOPE=

# ==============================================================================
# 구글 로그인
# ==============================================================================
# Google Cloud Console에서 발급
# 주의: 웹 클라이언트 비밀번호는 서버만 보관

# 구글 클라이언트 ID 목록 (웹, Android, iOS 모두 쉼표로)
GOOGLE_CLIENT_IDS=

# 구글 웹 클라이언트 ID (서버 흐름 및 앱 serverClientId)
GOOGLE_WEB_CLIENT_ID=

# 구글 웹 클라이언트 비밀번호 (서버만)
GOOGLE_CLIENT_SECRET=

# 구글 리디렉션 URI (보통 자동 생성됨)
# GOOGLE_REDIRECT_URI=

# ==============================================================================
# 보안 설정
# ==============================================================================

# 가짜 로그인 제공자 (1=활성화, 운영에서 반드시 끄기)
# AUTH_FAKE_PROVIDER=0

# 프록시 헤더 신뢰 (Cloud Run 등 프록시 뒤에서만 1로 설정)
# TRUST_PROXY_HEADERS=0

# POST /api/analyze 로그인 필수 여부 (1=필수, 0=선택)
# AUTH_REQUIRED_FOR_ANALYZE=0

# ==============================================================================
# 사진 품질 검사
# ==============================================================================
# AI 호출 전 서버에서 흐림/어두움/작음 등을 검사해 비용 절약
# 앱에서도 같은 방법으로 먼저 검사하되 더 엄격한 기준 사용

# 품질 검사 사용 여부 (0=끔)
# QUALITY_CHECK=1

# 흐림 기준 (라플라시안 분산, 낮을수록 흐림)
# QUALITY_BLUR_MIN=30

# 어두움 기준 (평균 밝기, 낮을수록 어두움)
# QUALITY_DARK_MEAN=40

# 과노출 기준 (밝은 화소 비율)
# QUALITY_BRIGHT_CLIPPED=0.95

# 빈 사진 기준 (글씨 영역 비율)
# QUALITY_BLANK_CONTENT=0.02

# 최소 사진 크기 (픽셀)
# QUALITY_MIN_SHORT_SIDE=400
# QUALITY_MIN_LONG_SIDE=600

# ==============================================================================
# 가족 연결
# ==============================================================================

# 초대 번호 유효 시간 (분)
# FAMILY_INVITE_TTL_MIN=30

# 한 사람당 최대 연결 수
# FAMILY_MAX_CHILDREN=10
# FAMILY_MAX_SENIORS=4

# 번호 맞히기 제한 (15분 동안)
# FAMILY_FAIL_WINDOW_MIN=15
# FAMILY_FAIL_LIMIT=10          # 사용자당 허용 횟수
# FAMILY_FAIL_LIMIT_IP=30       # IP당 허용 횟수

# 자녀가 어르신에게 하루에 대신 보낼 수 있는 서류 수
# FAMILY_SEND_DAILY_LIMIT=30

# ==============================================================================
# 푸시 알림 (Firebase Cloud Messaging)
# ==============================================================================

# 푸시 제공자: fcm / fake / none
# 비우면 서비스 계정이 있으면 fcm, 없으면 none (보내지 않고 기록만)
# PUSH_PROVIDER=

# FCM 서비스 계정 JSON 파일 경로 (절대 경로, git에 올리지 말 것)
# Windows 예: C:\secrets\ilgeodeurim-firebase-adminsdk.json
# FCM_SERVICE_ACCOUNT_FILE=

# 또는 JSON 원문 또는 base64 인코딩된 문자열 (Cloud Run 시크릿 등)
# FCM_SERVICE_ACCOUNT_JSON=

# FCM 프로젝트 ID (보통 서비스 계정 파일에서 자동으로 가져옴)
# FCM_PROJECT_ID=

# 푸시 전송 타임아웃 (초)
# PUSH_TIMEOUT_S=5
